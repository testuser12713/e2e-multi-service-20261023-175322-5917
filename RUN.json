{
  "runcontract": 1,
  "services": [
    {
      "name": "web",
      "dir": "frontend",
      "stack": "web-vite",
      "kind": "server",
      "install": [["npm", "ci"]],
      "build": [["npm", "run", "build"]],
      "test": [["npx", "vitest", "run"]],
      "start": ["npm", "run", "dev", "--", "--host", "127.0.0.1", "--port", "${PORT}", "--strictPort"],
      "port": 5173,
      "health": { "path": "/", "expect_status": [200] },
      "ready_timeout_s": 60,
      "env": {
        "VITE_API_BASE_URL": { "dev": "${service:api.origin}" }
      }
    }
  ]
}
