{
  "runcontract": 1,
  "services": [
    {
      "name": "web",
      "dir": "frontend",
      "stack": "web-vite",
      "kind": "server",
      "install": [
        [
          "npm",
          "ci"
        ]
      ],
      "build": [
        [
          "npm",
          "run",
          "build"
        ]
      ],
      "test": [
        [
          "npx",
          "vitest",
          "run"
        ]
      ],
      "start": [
        "npm",
        "run",
        "dev",
        "--",
        "--host",
        "127.0.0.1",
        "--port",
        "${PORT}",
        "--strictPort"
      ],
      "port": 5173,
      "health": {
        "path": "/",
        "expect_status": [
          200
        ]
      },
      "ready_timeout_s": 60,
      "env": {
        "VITE_API_BASE_URL": {
          "dev": "${service:api.origin}"
        }
      }
    },
    {
      "name": "api",
      "dir": "backend",
      "stack": "python",
      "kind": "server",
      "install": [
        [
          "${python}",
          "-m",
          "pip",
          "install",
          "-q",
          "-r",
          "requirements.txt"
        ]
      ],
      "start": [
        "${python}",
        "-m",
        "uvicorn",
        "app.main:app",
        "--port",
        "${PORT}"
      ],
      "port": 8000,
      "port_env": "PORT",
      "health": {
        "path": "/health",
        "expect_status": [
          200
        ]
      },
      "env": {
        "JOBS_DB_PATH": {
          "dev": "../data/jobs.db"
        },
        "CORS_ORIGINS": {
          "dev": "${service:web.origin}"
        }
      },
      "test": [
        [
          "${python}",
          "-m",
          "pytest"
        ]
      ]
    },
    {
      "name": "worker",
      "dir": ".",
      "stack": "python",
      "kind": "worker",
      "install": [
        [
          "${python}",
          "-m",
          "pip",
          "install",
          "-r",
          "worker/requirements.txt"
        ]
      ],
      "start": [
        "${python}",
        "-m",
        "worker"
      ],
      "test": [
        [
          "${python}",
          "-m",
          "pytest",
          "worker"
        ]
      ],
      "env": {
        "JOBS_DB_PATH": {
          "dev": "backend/data/jobs.db",
          "not_secret": true,
          "why": "a relative file path to the shared SQLite database (the API's default data/jobs.db, seen from the repo root); it grants no access to anything"
        },
        "WORKER_POLL_INTERVAL_SECONDS": {
          "dev": "2"
        }
      }
    }
  ]
}
